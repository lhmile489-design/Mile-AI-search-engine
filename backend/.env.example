# 复制为 .env 后填写真实值。.env 已被 .gitignore 忽略，不得提交。
# 模型名、接口地址需在 M0 实测后填写，不要照抄教程。

APP_HOST=127.0.0.1
APP_PORT=8000

# LLM（OpenAI 兼容接口）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# 搜索引擎
TAVILY_API_KEY=

# 信源分类服务（未确认，可留空，留空时使用本地域名规则）
CLASSIFIER_API_KEY=
CLASSIFIER_ENDPOINT=

# 数据库路径
DATABASE_PATH=data/mile_search.db

# 流水线超时（秒，可选，不填则用默认值）
# REWRITE_TIMEOUT_S=15
# SEARCH_TIMEOUT_S=10
# CLASSIFIER_TIMEOUT_S=2.5
# GENERATE_FIRST_TOKEN_TIMEOUT_S=30
# FINALIZE_TIMEOUT_S=10

# 重排取前 K 个信源
# RANKING_TOP_K=10

# SSE 心跳间隔（秒，默认 10）。测试时可设为 0.2 加速验证。
# HEARTBEAT_INTERVAL_S=10

# 结果缓存（默认开启）
# CACHE_ENABLED=true
# CACHE_L2_TTL_S=600
# CACHE_L1_TTL_S=600
# CACHE_MAX_SIZE=128
